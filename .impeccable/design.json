  "narrative": {
    "northStar": "UESL OpenCS workspace",
    "overview": "The Game Maker uses UESL's existing dark surfaces and cyan accent with the OpenCS workspace format. Named builder modes sit above a practical editing surface: setup, game preview and code. The interface keeps controls compact and legible so students can move between building and running a game.\n\nThis document covers UESL Play, the OpenCS Workbench, Open World and Racing builder frames, and the OCS primitives they share. It does not claim that every inherited historical page follows these rules. Default tokens come from `_sass/open-coding/_core.scss`; shared builder composition comes from `_builder-shell.scss`. User preferences can override theme colors, font and control radius.",
    "keyCharacteristics": [
      "One named workspace with three builder modes.",
      "Dark tonal panels, cyan selected states and visible keyboard focus.",
      "Inter controls and headings with a monospace code editor.",
      "Setup, preview and code columns that stack on smaller screens."
    ],
    "rules": [
      {
        "name": "The Shared Accent Rule",
        "body": "All three builder frames use the same preference-aware accent for selected controls and keyboard focus.",
        "section": "colors"
      },
      {
        "name": "The One Workspace Rule",
        "body": "Keep the same setup, preview, code and view-control arrangement across all three builders.",
        "section": "layout"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Use panel tone and borders to separate persistent editing regions; reserve floating depth for temporary feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the shared OCS controls and preference-aware theme tokens.",
      "Do keep setup, preview and code in the same arrangement across builder modes.",
      "Do preserve visible focus, named controls and responsive stacking.",
      "Do keep Run / Stop outside the panels that view controls hide."
    ],
    "donts": [
      "Don't introduce an unrelated visual theme for one inherited builder.",
      "Don't turn gameplay colors or overlays into global interface tokens.",
      "Don't hide the only way to stop a preview when switching views.",
      "Don't assume historical pages outside this workspace conform to this document."
    ]
  }
}
